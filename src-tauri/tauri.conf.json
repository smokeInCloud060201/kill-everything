{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KillEverything",
  "version": "0.1.0",
  "identifier": "com.killeverything.app",
  "mainBinaryName": "kill-everything",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "preRemoveScript": "installer/linux/prerm",
        "postRemoveScript": "installer/linux/postrm"
      },
      "rpm": {
        "preRemoveScript": "installer/linux/prerm",
        "postRemoveScript": "installer/linux/postrm"
      }
    }
  }
}
